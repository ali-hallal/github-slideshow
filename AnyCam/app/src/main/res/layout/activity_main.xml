<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fitsSystemWindows="true">

    <!-- The picture: full width, just under the top bar. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp">

        <com.anycam.app.ui.ViewfinderView
            android:id="@+id/viewfinder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.anycam.app.ui.MarksView
            android:id="@+id/marks"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/flash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/black" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginStart="24dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/status_bg"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="7dp"
            android:paddingEnd="14dp"
            android:paddingBottom="7dp"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:visibility="invisible" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/torch"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:drawableStart="@drawable/ic_torch"
            android:drawablePadding="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:text="@string/light_off"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/readout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/dim"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Controls: over the foot of the picture where the screen is short, below it where it is tall. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/scrim"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:id="@+id/zoomRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="8dp">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="36dp"
                android:background="@drawable/round_bg"
                android:clipToOutline="true"
                android:contentDescription="@string/last_photo"
                android:scaleType="centerCrop" />

            <com.anycam.app.ui.ShutterView
                android:id="@+id/shutter"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:contentDescription="@string/shutter" />

            <View
                android:id="@+id/switchCamera"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="36dp"
                android:background="@drawable/switch_bg"
                android:contentDescription="@string/switch_camera" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
